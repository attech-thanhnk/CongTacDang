# Sao chép thành .env và thay toàn bộ giá trị CHANGE_ME trước khi triển khai.
POSTGRES_DB=congtacdang_db
POSTGRES_USER=dangbo_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5434

MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=congtacdang-files
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_PORT=5050

# Mặc định không publish backend. Đặt thành ["127.0.0.1:5000:5000"] nếu cần truy cập trực tiếp.
BACKEND_PORTS=[]

# Số ngày giữ file log backend (volume attech-dangbo-backend-logs).
LOG_RETAINED_DAYS=30
