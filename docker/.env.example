# Sao chép thành .env và thay toàn bộ giá trị CHANGE_ME trước khi triển khai.
POSTGRES_DB=congtacdang_db
POSTGRES_USER=dangbo_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5434

MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=congtacdang-files
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_PORT=5050

# Mặc định không publish backend. Đặt thành ["127.0.0.1:5000:5000"] nếu cần truy cập trực tiếp.
BACKEND_PORTS=[]

# Số ngày giữ file log backend (volume attech-dangbo-backend-logs).
LOG_RETAINED_DAYS=30

# Tài khoản quản trị ban đầu: chỉ được tạo khi hệ thống CHƯA có tài khoản quản trị nào đang hoạt động
# (đã có → bỏ qua, không đổi mật khẩu). Bắt buộc đổi mật khẩu ngay ở lần đăng nhập đầu; sau đó có thể xóa
# mật khẩu khỏi file .env. Mật khẩu phải đạt chính sách (độ dài tối thiểu, có chữ và số).
Seed__InitialAdmin__Username=
Seed__InitialAdmin__FullName=
Seed__InitialAdmin__Password=

# Chính sách mật khẩu: độ dài tối thiểu mật khẩu mới (giá trị < 8 bị nâng lên 8; luôn yêu cầu có chữ và số).
Security__Password__MinLength=8
# Giới hạn gọi /api/auth/login và /api/auth/refresh-token: số lần mỗi cửa sổ thời gian trên mỗi địa chỉ IP.
Security__RateLimit__Auth__PermitLimit=10
Security__RateLimit__Auth__WindowSeconds=60
