# ---------------------------------------------------------------------------
# Dockerfile cho Backend .NET 10 Web API - Phân hệ Công tác Đảng ATTECH
# ---------------------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy toàn bộ solution và project files để cache restore layer
COPY backend/CongTacDang.slnx ./
COPY backend/src/CongTacDang.Domain/CongTacDang.Domain.csproj src/CongTacDang.Domain/
COPY backend/src/CongTacDang.Application/CongTacDang.Application.csproj src/CongTacDang.Application/
COPY backend/src/CongTacDang.Infrastructure/CongTacDang.Infrastructure.csproj src/CongTacDang.Infrastructure/
COPY backend/src/CongTacDang.Api/CongTacDang.Api.csproj src/CongTacDang.Api/

RUN dotnet restore src/CongTacDang.Api/CongTacDang.Api.csproj

# Copy toàn bộ mã nguồn và build Release
COPY backend/src/ src/
WORKDIR /src/src/CongTacDang.Api
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

# Runtime Image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production
# Log file xoay vòng theo ngày, nằm ngoài thư mục publish; compose mount volume vào đây
ENV Logging__File__Path=/var/log/congtacdang

# LibreOffice headless (chuyển DOCX/XLSX → PDF, task 05) kèm font:
# - fonts-liberation: Liberation Serif/Sans tương thích kích thước với Times New Roman/Arial (template dùng Times New Roman),
#   có đủ dấu tiếng Việt; fonts-dejavu-core làm font dự phòng.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
        libreoffice-writer-nogui libreoffice-calc-nogui \
        fonts-liberation fonts-dejavu-core fontconfig \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/uploads /var/log/congtacdang \
    && chown -R appuser:appuser /app /var/log/congtacdang

COPY --from=build /app/publish .
USER appuser
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 CMD curl --fail --silent http://localhost:5000/healthz || exit 1
ENTRYPOINT ["dotnet", "CongTacDang.Api.dll"]
