# =============================================================================
# GITIGNORE CHUẨN CHO DỰ ÁN CÔNG TÁC ĐẢNG (FULLSTACK .NET 10 + NEXT.JS 14)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. .NET & C# Build Artifacts
# -----------------------------------------------------------------------------
bin/
obj/
[Bb]in/
[Oo]bj/
*.dll
*.pdb
*.exe
*.deps.json
*.runtimeconfig.json
*.cache
*.FileListAbsolute.txt
*.sourcelink.json
project.assets.json
project.nuget.cache

# Visual Studio & IDEs
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.launchSettings.json.user

# -----------------------------------------------------------------------------
# 2. Frontend Node.js & Next.js
# -----------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/

# Next.js telemetry & cache
.vercel
# frontend/next-env.d.ts được commit: tsc --noEmit chạy trước next build (CI, checkout mới) cần file này.
*.tsbuildinfo

# NPM / Yarn / PNPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables files (bảo mật mật khẩu và key)
.env
.env*.local
!.env.example
docker/.env

# -----------------------------------------------------------------------------
# 3. Local Storage & Uploads
# -----------------------------------------------------------------------------
storage/
backend/storage/
backend/src/CongTacDang.Api/storage/
uploads/
*.log
logs/

# Kết quả publish .NET và cache dev Next.js
backend/publish/
backend/publish-*/
publish/
.next-dev/
frontend/.next-dev/

# Kết quả kiểm thử giao diện (báo cáo, ảnh, vết, nhật ký tiến trình)
frontend/e2e-ket-qua/

# Công cụ thử nghiệm cục bộ
scratch/

# -----------------------------------------------------------------------------
# 4. OS & System generated files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.tmp
*~

# -----------------------------------------------------------------------------
# 5. Database & Docker volumes
# -----------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
postgres-data/
pgadmin-data/

# Worktree tạm của agent Claude Code
.claude/worktrees/

# Font bản quyền chép vào để dựng image (docker/Dockerfile.backend), không commit
docker/fonts/*
!docker/fonts/.gitkeep

# File khóa tạm của Word/Excel
~$*

# Tài liệu chuẩn có phiếu đánh giá của người thật — không commit
docs/tai-lieu-chuan/
