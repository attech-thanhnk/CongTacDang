{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "CongTacDang.Api",
    "Audience": "CongTacDang.Client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "ExpiryDays": 7
  },
  "Seed": {
    "InitialAdmin": {
      "Username": "",
      "FullName": "",
      "Password": ""
    },
    "SamplePassword": ""
  },
  "Security": {
    "Password": {
      "MinLength": 8
    },
    "RateLimit": {
      "Auth": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      }
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Database": {
    "SeedSampleData": false,
    "ResetRolePermissions": false
  },
  "Organization": {
    "ApprovalAuthorityRefreshMinutes": 60
  },
  "Documents": {
    "Pdf": {
      "TimeoutSeconds": 60,
      "MaxConcurrency": 2
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [
      "127.0.0.1"
    ],
    "KnownNetworks": [
      "172.16.0.0/12"
    ]
  }
}
